# Copy to .env and adjust as needed. All values have safe dev defaults, so the app
# runs fully without editing this file (sandbox profile simulates external services).

# --- Spring ---
SPRING_PROFILES_ACTIVE=sandbox
SERVER_PORT=8080

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5433/finova
DB_USERNAME=finova
DB_PASSWORD=finova

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Security ---
# Base64-encoded 256-bit secret. Generate a new one for production.
JWT_SECRET=Zmlub3ZhLWRldi1zZWNyZXQtY2hhbmdlLW1lLWluLXByb2R1Y3Rpb24tMTIzNDU2Nzg5MA==
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=7
# 32-byte (256-bit) key for AES-GCM data-at-rest encryption (Base64). Change in production.
AES_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# --- External integrations (optional; sandbox profile ignores these) ---
STRIPE_SECRET_KEY=
CURRENCY_API_BASE=https://api.exchangerate.host
WEATHER_API_KEY=
MAPS_API_KEY=
